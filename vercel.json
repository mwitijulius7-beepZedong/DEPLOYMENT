{
  "version": 2,
  "builds": [
    { 
      "src": "server.js", 
      "use": "@vercel/node",
      "config": {
          "includeFiles": [
            "*.html",
            "*.css",
            "*.json",
            "public/**",
            "styles/**",
            "components/**",
            "src/**",
            "uploads/**",
            "utils/**",
            "middleware/**"
          ]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "server.js" }
  ]
}
