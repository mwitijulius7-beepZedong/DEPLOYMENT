# Example environment variables for local development and Vercel
# Copy this file to .env and fill in values before running locally.

# Server
PORT=3000

# MongoDB connection string (if used)
MONGODB_URI=mongodb://localhost:27017/birthday-blog

# Session secret used by express-session
SESSION_SECRET=replace-with-secure-random-string

# Email (for nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Cloudinary (if used for uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# JWT secret (if used)
JWT_SECRET=replace-with-secure-random-string

# MPesa (Safaricom Daraja API) — for template purchases
# Get credentials from https://developer.safaricom.co.ke
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://yourdomain.com/api/payments/callback
# BASE_URL is used as fallback for the callback URL if MPESA_CALLBACK_URL is empty
BASE_URL=http://localhost:3000

# Social Auto-Post (configured via admin panel, stored in settings.json)
# Twitter/X: Get API keys from https://developer.x.com/
# LinkedIn: Get access token from https://www.linkedin.com/developers/ (scope: w_member_social)
# Facebook: Get page token from https://developers.facebook.com/ (permission: pages_manage_posts)
# Mastodon: Create app in instance Settings > Development > New Application
