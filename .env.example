# Example environment variables for local development and Vercel
# Copy this file to .env and fill in values before running locally.

# Server
PORT=3000

# MongoDB connection string (if used)
MONGODB_URI=mongodb://localhost:27017/birthday-blog

# Session secret used by express-session
SESSION_SECRET=replace-with-secure-random-string

# Email (for nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Cloudinary (if used for uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# JWT secret (if used)
JWT_SECRET=replace-with-secure-random-string

# MPesa (Safaricom Daraja API) — for template purchases
# Get credentials from https://developer.safaricom.co.ke
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://yourdomain.com/api/payments/callback
# BASE_URL is used as fallback for the callback URL if MPESA_CALLBACK_URL is empty
BASE_URL=http://localhost:3000

# Social Auto-Post (configured via admin panel, stored in settings.json)
# Twitter/X: Get API keys from https://developer.x.com/
# LinkedIn: Get access token from https://www.linkedin.com/developers/ (scope: w_member_social)
# Facebook: Get page token from https://developers.facebook.com/ (permission: pages_manage_posts)
# Mastodon: Create app in instance Settings > Development > New Application

# First-run admin setup (see /auth/setup)
# On a brand-new environment with an empty user store, set this to true once so
# the first admin account can be created from a remote browser, then remove it.
# ALLOW_FIRST_RUN_SETUP=true

# Extra CORS origins (comma-separated); localhost + Vercel previews are always allowed
# ALLOWED_ORIGINS=https://yourdomain.com

# Google Sign-In (OAuth Web client id, NOT a secret)
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Authorized JavaScript origins must include this site's origin (e.g. http://localhost:3000 and your Vercel URL).
# The id is served to the browser via GET /api/auth/google-client, so only this env var needs updating.
# GOOGLE_CLIENT_ID=xxxxxxxxxxxxxxxx.apps.googleusercontent.com

# ── Supabase (primary data + storage backend) ───────────────────────────────
# Create a project at https://supabase.com, then run supabase/schema.sql in the
# SQL editor. When SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set, the app
# uses Supabase for data and uploads. Leave them unset to keep using MongoDB/KV/
# JSON files.
#
# The service-role key bypasses RLS. Keep it server-side only: never expose it
# to the browser or commit it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: only needed if a browser client talks to Supabase directly.
# SUPABASE_ANON_KEY=
# Public storage bucket used for image/video uploads (created by schema.sql).
SUPABASE_STORAGE_BUCKET=uploads
#
# Force a legacy backend even when Supabase is configured:
#   DATA_BACKEND=mongo  -> MongoDB (then KV, then JSON files)
#   DATA_BACKEND=file   -> Vercel KV / local JSON files
# DATA_BACKEND=

# One-way data migration (run once after the schema exists):
#   node scripts/migrate-to-supabase.js --dry-run
#   node scripts/migrate-to-supabase.js
# Add --source=json to ignore MongoDB, or --only=users,posts to limit scope.
